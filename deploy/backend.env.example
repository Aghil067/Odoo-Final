# Copy outside the repository to /etc/solar/backend.env with owner-only access.
# Use a separate migration-owner connection when running prisma migrate deploy.
NODE_ENV=production
BIND_HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://solar_app:REPLACE_WITH_PRIVATE_URL_ENCODED_PASSWORD@127.0.0.1:5432/solar?schema=public&connection_limit=10&pool_timeout=10
APP_ORIGIN=https://solar.example.invalid
COOKIE_SAME_SITE=lax
SESSION_HOURS=8
DEFAULT_PHONE_COUNTRY=IN
# Matches exactly the one loopback reverse proxy in nginx.conf.
TRUST_PROXY_HOPS=1
# Pre-create these persistent directories owned by solar:solar, mode 0700.
SURVEY_STORAGE_ADAPTER=local
SURVEY_STORAGE_DIR=/var/lib/solar/evidence/surveys
INSTALLATION_STORAGE_DIR=/var/lib/solar/evidence/installations
WARRANTY_STORAGE_DIR=/var/lib/solar/evidence/warranties
SERVICE_STORAGE_DIR=/var/lib/solar/evidence/service
FINANCE_STORAGE_DIR=/var/lib/solar/evidence/finance
SURVEY_MAX_FILE_BYTES=5242880
INSTALLATION_MAX_FILE_BYTES=5242880
WARRANTY_MAX_FILE_BYTES=5242880
SERVICE_MAX_FILE_BYTES=5242880
FINANCE_MAX_FILE_BYTES=5242880
