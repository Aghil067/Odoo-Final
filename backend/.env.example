NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://solar_user:CHANGE_ME@localhost:5432/solar_crm?schema=public
APP_ORIGIN=http://localhost:5173
COOKIE_SAME_SITE=lax
SESSION_HOURS=8
DEFAULT_PHONE_COUNTRY=IN
# Set to 1 only behind a trusted single reverse proxy; otherwise keep 0.
TRUST_PROXY_HOPS=0
# Private survey evidence defaults to ~/.solar-installation/survey-uploads.
# Run backend commands from backend/; storage must be outside the frontend repository.
SURVEY_STORAGE_ADAPTER=local
# SURVEY_STORAGE_DIR=C:/SolarPrivate/survey-uploads
SURVEY_MAX_FILE_BYTES=5242880
# Set temporarily in the operator's shell, never commit actual credentials:
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=
# USER_EMAIL=
# USER_NAME=
# USER_PASSWORD=
# USER_ROLE=SALES
# Private installation evidence defaults to ~/.solar-installation/installation-uploads.
# INSTALLATION_STORAGE_DIR=C:/SolarPrivate/installation-uploads
INSTALLATION_MAX_FILE_BYTES=5242880
# Private warranty evidence defaults to ~/.solar-installation/warranty-uploads.
# WARRANTY_STORAGE_DIR=C:/SolarPrivate/warranty-uploads
WARRANTY_MAX_FILE_BYTES=5242880
# Private service evidence defaults to ~/.solar-installation/service-uploads.
# SERVICE_STORAGE_DIR=C:/SolarPrivate/service-uploads
SERVICE_MAX_FILE_BYTES=5242880
# Private finance evidence defaults to ~/.solar-installation/finance-uploads.
# FINANCE_STORAGE_DIR=C:/SolarPrivate/finance-uploads
FINANCE_MAX_FILE_BYTES=5242880
