{
  "name": "solar-crm-m01",
  "version": "1.0.0",
  "private": true,
  "description": "Solar Installation Management System — M01 backend",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "user:create": "tsx scripts/create-user.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "libphonenumber-js": "1.13.15",
    "zod": "4.6.7"
  },
  "overrides": {
    "@prisma/config": { "deepmerge-ts": "8.0.0" }
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
