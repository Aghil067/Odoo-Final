generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  TECHNICIAN
  WAREHOUSE
  SUPPORT
  FINANCE
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum LeadSource {
  WEBSITE
  PHONE
  WALK_IN
  REFERRAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  SURVEY_REQUESTED
  LOST
  DISQUALIFIED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SystemType {
  ON_GRID
  OFF_GRID
  UNDECIDED
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  FOLLOW_UP
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  name         String   @db.VarChar(120)
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  inventoryOperations InventoryOperation[]
  sessions     Session[]
  customers    Customer[]
  createdLeads Lead[] @relation("LeadCreator")
  assignedLeads Lead[] @relation("LeadSalesperson")
  activities   LeadActivity[]
  statusHistory LeadStatusHistory[]
  requestedSurveys SiteSurvey[] @relation("SurveyRequester")
  assignedSurveys SiteSurvey[] @relation("Surveyor")
  surveyEvents SurveyStatusHistory[]
  surveyReviews SurveyReview[]
  surveyUploads SurveyAttachment[]
  solarTemplates SolarSystemTemplate[]
  solarComponents SolarComponent[]
  solarConfigurations SolarConfiguration[] @relation("ConfigurationDesigner")
  reviewedConfigurations SolarConfiguration[] @relation("ConfigurationReviewer")
  configurationEvents SolarConfigurationHistory[]
  configurationReviews SolarConfigurationReview[]
  templateRevisions SolarTemplateRevision[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.Char(64)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id              String       @id @default(uuid()) @db.Uuid
  reference       String       @unique @db.VarChar(40)
  type            CustomerType @default(INDIVIDUAL)
  name            String       @db.VarChar(160)
  phone           String       @db.VarChar(40)
  normalizedPhone String       @db.VarChar(16)
  email           String?      @db.VarChar(254)
  companyName     String?      @db.VarChar(160)
  notes           String?      @db.VarChar(5000)
  isArchived      Boolean      @default(false)
  archivedAt      DateTime?    @db.Timestamptz(3)
  version         Int          @default(1)
  createdById     String       @db.Uuid
  createdBy       User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  sites           Site[]
  leads           Lead[]
  surveys         SiteSurvey[]
  configurations  SolarConfiguration[]
  @@index([normalizedPhone])
  @@index([email])
  @@index([createdById, isArchived])
  @@index([isArchived, createdAt, id])
  @@index([type])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([reference(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([companyName(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Site {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @db.Uuid
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name          String   @db.VarChar(160)
  addressLine1  String   @db.VarChar(250)
  addressLine2  String?  @db.VarChar(250)
  city          String   @db.VarChar(100)
  state         String   @db.VarChar(100)
  postalCode    String   @db.VarChar(20)
  country       String   @db.Char(2)
  landmark      String?  @db.VarChar(250)
  propertyNotes String?  @db.VarChar(5000)
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  leads         Lead[]
  surveys       SiteSurvey[]
  configurations SolarConfiguration[]
  @@unique([id, customerId])
  @@index([customerId, createdAt, id])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Lead {
  id                     String       @id @default(uuid()) @db.Uuid
  reference              String       @unique @db.VarChar(40)
  customerId             String       @db.Uuid
  customer               Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  siteId                 String       @db.Uuid
  site                   Site         @relation(fields: [siteId, customerId], references: [id, customerId], onDelete: Restrict)
  source                 LeadSource
  status                 LeadStatus   @default(NEW)
  priority               LeadPriority @default(MEDIUM)
  requestedCapacityKw    Decimal?     @db.Decimal(10, 3)
  preferredSystemType    SystemType   @default(UNDECIDED)
  monthlyElectricityBill Decimal?     @db.Decimal(14, 2)
  assignedToId           String?      @db.Uuid
  assignedTo             User?        @relation("LeadSalesperson", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdById            String       @db.Uuid
  createdBy              User         @relation("LeadCreator", fields: [createdById], references: [id], onDelete: Restrict)
  qualificationNotes     String?      @db.VarChar(5000)
  nextFollowUpAt         DateTime?    @db.Timestamptz(3)
  closedReason           String?      @db.VarChar(2000)
  version                Int          @default(1)
  createdAt              DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @db.Timestamptz(3)
  activities             LeadActivity[]
  statusHistory          LeadStatusHistory[]
  surveys                SiteSurvey[]
  configurations         SolarConfiguration[]
  @@unique([id, siteId, customerId])
  @@index([customerId])
  @@index([siteId, customerId])
  @@index([status, createdAt, id])
  @@index([assignedToId, status])
  @@index([createdById])
  @@index([source])
  @@index([priority])
  @@index([nextFollowUpAt])
  @@index([reference(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([qualificationNotes(ops: raw("gin_trgm_ops"))], type: Gin)
}

model LeadActivity {
  id          String       @id @default(uuid()) @db.Uuid
  leadId      String       @db.Uuid
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Restrict)
  actorId     String       @db.Uuid
  actor       User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  type        ActivityType
  description String       @db.VarChar(5000)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  @@index([leadId, createdAt, id])
  @@index([actorId])
}

model LeadStatusHistory {
  id         String     @id @default(uuid()) @db.Uuid
  leadId     String     @db.Uuid
  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Restrict)
  actorId    String     @db.Uuid
  actor      User       @relation(fields: [actorId], references: [id], onDelete: Restrict)
  fromStatus LeadStatus?
  toStatus   LeadStatus
  reason     String?    @db.VarChar(2000)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  @@index([leadId, createdAt, id])
  @@index([actorId])
}

enum SurveyStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  SUBMITTED
  REVISION_REQUIRED
  APPROVED
  REJECTED
  CANCELED
}

enum SurveyVisitStatus {
  NOT_SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum SurveyEvent {
  REQUESTED
  ASSIGNED
  SCHEDULED
  RESCHEDULED
  STARTED
  UPDATED
  ROOF_UPDATED
  ELECTRICAL_UPDATED
  ATTACHMENT_ADDED
  SUBMITTED
  REVIEWED
  CANCELED
}

enum RoofType {
  RCC
  METAL
  TILE
  OTHER
}

enum ShadingLevel {
  NONE
  LOW
  MODERATE
  HIGH
}

enum RoofAccessibility {
  ACCESSIBLE
  RESTRICTED
  UNSAFE
  UNKNOWN
}

enum RoofCondition {
  GOOD
  FAIR
  POOR
  UNKNOWN
}

enum GridConnection {
  CONNECTED
  NOT_CONNECTED
  UNKNOWN
}

enum SupplyPhase {
  SINGLE_PHASE
  THREE_PHASE
  UNKNOWN
}

enum SiteSuitability {
  UNASSESSED
  SUITABLE
  CONDITIONALLY_SUITABLE
  NOT_SUITABLE
}

enum SurveyAttachmentCategory {
  ROOF_PHOTO
  METER_PHOTO
  PANEL_PHOTO
  SITE_LAYOUT
  SUPPORTING_FILE
}

enum SurveyReviewDecision {
  APPROVED
  REVISION_REQUIRED
  REJECTED
}

model SiteSurvey {
  id                     String @id @default(uuid()) @db.Uuid
  reference              String @unique @db.VarChar(40)
  leadId                 String @db.Uuid
  siteId                 String @db.Uuid
  customerId             String @db.Uuid
  lead                   Lead @relation(fields: [leadId, siteId, customerId], references: [id, siteId, customerId], onDelete: Restrict, onUpdate: Restrict)
  site                   Site @relation(fields: [siteId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Restrict)
  customer               Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assessmentNumber       Int @default(1)
  previousSurveyId       String? @unique @db.Uuid
  previousSurvey         SiteSurvey? @relation("SurveyReassessment", fields: [previousSurveyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reassessment           SiteSurvey? @relation("SurveyReassessment")
  requestedById          String @db.Uuid
  requestedBy            User @relation("SurveyRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  assignedToId           String? @db.Uuid
  assignedTo             User? @relation("Surveyor", fields: [assignedToId], references: [id], onDelete: Restrict)
  status                 SurveyStatus @default(REQUESTED)
  visitStatus            SurveyVisitStatus @default(NOT_SCHEDULED)
  requestNotes           String @db.VarChar(2000)
  assignmentNotes        String? @db.VarChar(2000)
  scheduledAt            DateTime? @db.Timestamptz(3)
  scheduledEndAt         DateTime? @db.Timestamptz(3)
  expectedDurationMinutes Int?
  startedAt              DateTime? @db.Timestamptz(3)
  submittedAt            DateTime? @db.Timestamptz(3)
  requestedCapacityKw    Decimal? @db.Decimal(10, 3)
  recommendedCapacityKw  Decimal? @db.Decimal(10, 3)
  recommendedSystemType  SystemType @default(UNDECIDED)
  suitability            SiteSuitability @default(UNASSESSED)
  infeasibilityReason    String? @db.VarChar(2000)
  additionalWorkRequired String? @db.VarChar(5000)
  technicalAssumptions   String? @db.VarChar(5000)
  feasibilityNotes       String? @db.VarChar(5000)
  approvedVersion        Int?
  version                Int @default(1)
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)
  roofAssessment         RoofAssessment?
  electricalAssessment   ElectricalAssessment?
  attachments            SurveyAttachment[]
  history                SurveyStatusHistory[]
  reviews                SurveyReview[]
  configurations         SolarConfiguration[]
  @@unique([id, leadId, siteId, customerId])
  @@unique([leadId, assessmentNumber])
  @@index([customerId])
  @@index([siteId, customerId])
  @@index([status, createdAt, id])
  @@index([assignedToId, scheduledAt])
  @@index([requestedById])
}

model RoofAssessment {
  id                     String @id @default(uuid()) @db.Uuid
  surveyId               String @unique @db.Uuid
  survey                 SiteSurvey @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  roofType               RoofType
  roofTypeDetails        String? @db.VarChar(2000)
  usableAreaSqm          Decimal @db.Decimal(12, 3)
  azimuthDegrees         Decimal @db.Decimal(6, 3)
  tiltDegrees            Decimal @db.Decimal(5, 3)
  shadingLevel           ShadingLevel
  shadingObservations    String @db.VarChar(5000)
  nearbyObstructions     String @db.VarChar(5000)
  mountingSpaceSqm       Decimal @db.Decimal(12, 3)
  accessibility          RoofAccessibility
  accessibilityNotes     String @db.VarChar(2000)
  visibleCondition       RoofCondition
  conditionNotes         String @db.VarChar(5000)
  mountingConcerns       String @db.VarChar(5000)
  structuralNotes        String @db.VarChar(5000)
  specialistVerificationRequired Boolean
  recommendations        String @db.VarChar(5000)
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)
}

model ElectricalAssessment {
  id                     String @id @default(uuid()) @db.Uuid
  surveyId               String @unique @db.Uuid
  survey                 SiteSurvey @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  gridConnection         GridConnection
  supplyPhase            SupplyPhase
  meterDetails           String? @db.VarChar(2000)
  panelPresent           Boolean
  panelObservations      String @db.VarChar(5000)
  approximateCableRunMeters Decimal? @db.Decimal(10, 3)
  earthingObservations   String @db.VarChar(5000)
  inverterPlacementOptions String @db.VarChar(5000)
  batteryPlacementConsiderations String? @db.VarChar(5000)
  safetyConcerns         String @db.VarChar(5000)
  safetyVerificationRequired Boolean
  gridSuitabilityObservations String @db.VarChar(5000)
  additionalNotes        String @db.VarChar(5000)
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)
}

model SurveyAttachment {
  id          String @id @default(uuid()) @db.Uuid
  surveyId    String @db.Uuid
  survey      SiteSurvey @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  uploaderId  String @db.Uuid
  uploader    User @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  category    SurveyAttachmentCategory
  fileName    String @db.VarChar(100)
  mimeType    String @db.VarChar(50)
  sizeBytes   Int
  sha256      String @db.Char(64)
  storageKey  String @unique @db.VarChar(80)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  @@index([surveyId, createdAt, id])
  @@index([uploaderId])
}

model SurveyStatusHistory {
  id            String @id @default(uuid()) @db.Uuid
  surveyId      String @db.Uuid
  survey        SiteSurvey @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  actorId       String @db.Uuid
  actor         User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  event         SurveyEvent
  fromStatus    SurveyStatus?
  toStatus      SurveyStatus
  surveyVersion Int
  reason        String @db.VarChar(2000)
  details       Json
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  @@index([surveyId, createdAt, id])
  @@index([actorId])
}

model SurveyReview {
  id            String @id @default(uuid()) @db.Uuid
  surveyId      String @db.Uuid
  survey        SiteSurvey @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  reviewerId    String @db.Uuid
  reviewer      User @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  decision      SurveyReviewDecision
  surveyVersion Int
  notes         String @db.VarChar(5000)
  checklist     Json
  snapshot      Json
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  configurations SolarConfiguration[]
  @@unique([id, surveyId, surveyVersion])
  @@unique([surveyId, surveyVersion])
  @@index([reviewerId])
}

enum SolarComponentCategory {
  SOLAR_PANEL
  INVERTER
  BATTERY
  CHARGE_CONTROLLER
  MOUNTING_STRUCTURE
  DC_CABLE
  AC_CABLE
  CONNECTOR
  COMBINER_BOX
  ISOLATOR
  SURGE_PROTECTION
  EARTHING
  OTHER
}

enum SolarUnit {
  PCS
  M
  SET
  PAIR
  KG
}

enum SolarConfigurationStatus {
  DRAFT
  READY_FOR_REVIEW
  REVISION_REQUIRED
  APPROVED
  REJECTED
  ARCHIVED
}

enum SolarPhase {
  SINGLE_PHASE
  THREE_PHASE
}

enum SolarReviewDecision {
  APPROVED
  REVISION_REQUIRED
  REJECTED
}

model SolarComponent {
  inventoryBalances InventoryBalance[]
  inventorySerials InventorySerialUnit[]
  stockReservationLines StockReservationLine[]
  stockTransfers StockTransfer[]
  id             String @id @default(uuid()) @db.Uuid
  sku            String @unique @db.VarChar(64)
  name           String @db.VarChar(160)
  category       SolarComponentCategory
  manufacturer   String? @db.VarChar(160)
  modelNumber    String? @db.VarChar(160)
  description    String? @db.VarChar(2000)
  specifications Json
  specificationSource String? @db.VarChar(2000)
  unit           SolarUnit
  unitCost       Decimal @db.Decimal(18, 4)
  currency       String @db.Char(3)
  warrantyMonths Int?
  serializationRequired Boolean @default(false)
  lastChangeReason String @default("Catalog created") @db.VarChar(2000)
  isActive       Boolean @default(true)
  version        Int @default(1)
  createdById    String @db.Uuid
  createdBy      User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  templateLines  SolarTemplateComponent[]
  bomLines       BOMLine[]
  @@index([category, isActive])
  @@index([createdById])
}

model SolarSystemTemplate {
  id             String @id @default(uuid()) @db.Uuid
  code           String @unique @db.VarChar(64)
  name           String @db.VarChar(160)
  description    String? @db.VarChar(2000)
  systemType     SystemType
  nominalCapacityKw Decimal @db.Decimal(10, 3)
  minimumCapacityKw Decimal @db.Decimal(10, 3)
  maximumCapacityKw Decimal @db.Decimal(10, 3)
  validationPolicy Json
  isActive       Boolean @default(true)
  version        Int @default(1)
  createdById    String @db.Uuid
  createdBy      User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  components     SolarTemplateComponent[]
  revisions      SolarTemplateRevision[]
  @@index([systemType, isActive])
  @@index([createdById])
}

model SolarTemplateComponent {
  id             String @id @default(uuid()) @db.Uuid
  templateId     String @db.Uuid
  template       SolarSystemTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  componentId    String @db.Uuid
  component      SolarComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  defaultQuantity Decimal @db.Decimal(12, 3)
  unit           SolarUnit
  required       Boolean
  notes          String? @db.VarChar(1000)
  position       Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  @@unique([templateId, componentId])
  @@unique([templateId, position])
  @@index([componentId])
}

model SolarTemplateRevision {
  id             String @id @default(uuid()) @db.Uuid
  templateId     String @db.Uuid
  template       SolarSystemTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  version        Int
  actorId        String @db.Uuid
  actor          User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  snapshot       Json
  reason         String @db.VarChar(2000)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  configurations SolarConfiguration[]
  @@unique([templateId, version])
  @@index([actorId])
}

model SolarConfiguration {
  stockReservations StockReservation[]
  id             String @id @default(uuid()) @db.Uuid
  reference      String @unique @db.VarChar(40)
  name           String @db.VarChar(160)
  seriesId       String @default(uuid()) @db.Uuid
  revisionNumber Int @default(1)
  previousConfigurationId String? @unique @db.Uuid
  previousConfiguration SolarConfiguration? @relation("ConfigurationRevision", fields: [previousConfigurationId], references: [id], onDelete: Restrict)
  nextRevision   SolarConfiguration? @relation("ConfigurationRevision")
  leadId         String @db.Uuid
  lead           Lead @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  siteId         String @db.Uuid
  site           Site @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customerId     String @db.Uuid
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedSurveyId String @db.Uuid
  approvedSurveyVersion Int
  survey         SiteSurvey @relation(fields: [approvedSurveyId, leadId, siteId, customerId], references: [id, leadId, siteId, customerId], onDelete: Restrict, onUpdate: Restrict)
  surveyReviewId String @db.Uuid
  surveyReview   SurveyReview @relation(fields: [surveyReviewId, approvedSurveyId, approvedSurveyVersion], references: [id, surveyId, surveyVersion], onDelete: Restrict, onUpdate: Restrict)
  surveySnapshot Json
  templateId     String? @db.Uuid
  templateVersion Int?
  templateRevision SolarTemplateRevision? @relation(fields: [templateId, templateVersion], references: [templateId, version], onDelete: Restrict, onUpdate: Restrict)
  templateSnapshot Json?
  systemType     SystemType
  outputPhase    SolarPhase
  targetCapacityKw Decimal @db.Decimal(10, 3)
  calculatedDcCapacityKw Decimal? @db.Decimal(24, 6)
  inverterAcCapacityKw Decimal? @db.Decimal(24, 6)
  batteryNominalEnergyKwh Decimal? @db.Decimal(24, 6)
  status         SolarConfigurationStatus @default(DRAFT)
  technicalAssumptions String @db.VarChar(5000)
  conditionalWorkRequirements String? @db.VarChar(5000)
  validationPolicy Json
  electricalDesign Json
  validationReport Json
  createdById    String @db.Uuid
  createdBy      User @relation("ConfigurationDesigner", fields: [createdById], references: [id], onDelete: Restrict)
  reviewerId     String? @db.Uuid
  reviewer       User? @relation("ConfigurationReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  approvedVersion Int?
  version        Int @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  bom            BillOfMaterials?
  history        SolarConfigurationHistory[]
  reviews        SolarConfigurationReview[]
  @@unique([seriesId, revisionNumber])
  @@index([leadId])
  @@index([siteId])
  @@index([customerId])
  @@index([approvedSurveyId, leadId, siteId, customerId])
  @@index([surveyReviewId, approvedSurveyId, approvedSurveyVersion])
  @@index([templateId, templateVersion])
  @@index([status, createdAt, id])
  @@index([createdById])
  @@index([reviewerId])
}

model BillOfMaterials {
  stockReservations StockReservation[]
  id             String @id @default(uuid()) @db.Uuid
  reference      String @unique @db.VarChar(40)
  configurationId String @unique @db.Uuid
  configuration  SolarConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  version        Int @default(1)
  status         SolarConfigurationStatus @default(DRAFT)
  totalEstimatedMaterialCost Decimal @default(0) @db.Decimal(24, 2)
  currency       String @db.Char(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  lines          BOMLine[]
}

model BOMLine {
  stockReservationLines StockReservationLine[]
  id             String @id @default(uuid()) @db.Uuid
  bomId          String @db.Uuid
  bom            BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Restrict)
  componentId    String @db.Uuid
  component      SolarComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  componentVersion Int
  skuSnapshot    String @db.VarChar(64)
  descriptionSnapshot String @db.VarChar(2400)
  componentSnapshot Json
  category       SolarComponentCategory
  quantity       Decimal @db.Decimal(12, 3)
  unit           SolarUnit
  unitCostSnapshot Decimal @db.Decimal(18, 4)
  currency       String @db.Char(3)
  lineTotal      Decimal @db.Decimal(24, 2)
  technicalNotes String? @db.VarChar(1000)
  position       Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  @@unique([bomId, componentId])
  @@unique([bomId, position])
  @@index([componentId])
}

model SolarConfigurationHistory {
  id             String @id @default(uuid()) @db.Uuid
  configurationId String @db.Uuid
  configuration  SolarConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  actorId        String @db.Uuid
  actor          User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  event          String @db.VarChar(40)
  fromStatus     SolarConfigurationStatus?
  toStatus       SolarConfigurationStatus
  version        Int
  reason         String @db.VarChar(2000)
  details        Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  @@unique([configurationId, version])
  @@index([actorId])
}

model SolarConfigurationReview {
  id             String @id @default(uuid()) @db.Uuid
  configurationId String @db.Uuid
  configuration  SolarConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  reviewerId     String @db.Uuid
  reviewer       User @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
